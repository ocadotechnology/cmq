from cmq.aws.aws import AWSResource as AWSResource
from datetime import datetime

class metric(AWSResource):
    def __init__(self, parent=None) -> None: ...
    def statistic(self, statistic: str, namespace: str, metric_name: str, dimensions: dict = {}, period: int = ..., unit: str = 'Count', start_time: datetime = None, end_time: datetime = None) -> metric: ...
    def max(self, **kwargs) -> metric: ...
    def min(self, **kwargs) -> metric: ...
    def avg(self, **kwargs) -> metric: ...
    def sum(self, **kwargs) -> metric: ...
    def plot(self, unit_factor: int = 1) -> None: ...

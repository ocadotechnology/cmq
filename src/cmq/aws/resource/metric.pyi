from cmq.aws.aws import AWSResource as AWSResource
from datetime import datetime
from typing import Any, Optional

class metric(AWSResource):
    def __init__(self, parent: Any = None) -> None: ...
    def statistic(self, statistic: str, namespace: str, metric_name: str, dimensions: dict = ..., period: int = ..., unit: str = 'Count', start_time: Optional[datetime] = None, end_time: Optional[datetime] = None) -> metric: ...
    def max(self, **kwargs: Any) -> metric: ...
    def min(self, **kwargs: Any) -> metric: ...
    def avg(self, **kwargs: Any) -> metric: ...
    def sum(self, **kwargs: Any) -> metric: ...
    def plot(self, unit_factor: int = 1, **kwargs: Any) -> None: ...

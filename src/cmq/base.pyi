from _typeshed import Incomplete
from typing import Any, Callable, Optional
from cmq.plugin import ResourcePlugin as ResourcePlugin, SessionPlugin as SessionPlugin

class NodeInterface:
    def __init__(self, parent: Any) -> None: ...
    def __call__(self) -> Any: ...
    def root(self) -> ResourceInterface: ...
    def traverse(self, context: Any) -> None: ...

class ResourceInterface(NodeInterface):
    def __init__(self, parent: Any) -> None: ...
    def __call__(self) -> Any: ...
    def root(self) -> ResourceInterface: ...
    def traverse(self, context: Any) -> None: ...
    def attr(self, *args: list[str]) -> ResourceInterface: ...
    def filter(self, func: Callable[..., Any]) -> ResourceInterface: ...
    def transform(self, key: str, func: Callable[..., Any]) -> ResourceInterface: ...
    def calculate(self, key: str, func: Callable[..., Any]) -> ResourceInterface: ...
    def eq(self, key: Any, value: Any) -> ResourceInterface: ...
    def ne(self, key: Any, value: Any) -> ResourceInterface: ...
    def in_(self, key: Any, value: Any) -> ResourceInterface: ...
    def contains(self, key: Any, value: Any) -> ResourceInterface: ...
    def not_contains(self, key: Any, value: Any) -> ResourceInterface: ...
    def starts_with(self, key: Any, value: Any) -> ResourceInterface: ...
    def ends_with(self, key: Any, value: Any) -> ResourceInterface: ...
    def gt(self, key: Any, value: Any) -> ResourceInterface: ...
    def lt(self, key: Any, value: Any) -> ResourceInterface: ...
    def context(self, status: Any) -> None: ...
    def progress(self, resources: Any) -> None: ...

class PagedResourceInterface(ResourceInterface):
    def __init__(self, parent: Any) -> None: ...
    def limit(self, limit: int) -> PagedResourceInterface: ...
    def get_paged_results(self, page: Any) -> list: ...
    def paginate(self, context: Any) -> list: ...

class Resource(PagedResourceInterface, ResourcePlugin):
    def __init__(self, parent: Any) -> None: ...
    def enable_console(self) -> bool: ...
    def list(self, sort: Optional[str] = None) -> list: ...
    def dict(self) -> dict: ...
    def csv(self, flat: bool = False, sort: Optional[str] = None) -> str: ...
    def do(self, action: Callable[..., Any]) -> None: ...

class Session(Resource, SessionPlugin):
    console: Incomplete
    def context(self, status: Any) -> Any: ...
    def get_sessions(self) -> list: ...
    def get_session_context(self, resource: dict) -> dict: ...
    def traverse(self, context: Any) -> None: ...
